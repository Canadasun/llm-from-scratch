# Security knowledge — multiple choice, scored by likelihood (base-model friendly).
{"id": "sec-sqli", "category": "security", "type": "multiple_choice", "prompt": "Q: The best defence against SQL injection is to\nA: ", "choices": ["use parameterised queries that bind user input as data", "escape single quotes in the user input by hand", "hide the database error messages from users", "run the database as a less privileged user"], "answer": 0}
{"id": "sec-xss", "category": "security", "type": "multiple_choice", "prompt": "Q: Cross-site scripting (XSS) is prevented primarily by\nA: ", "choices": ["using a longer session timeout", "context-aware output encoding of untrusted data", "enabling gzip compression", "storing passwords as hashes"], "answer": 1}
{"id": "sec-pwstore", "category": "security", "type": "multiple_choice", "prompt": "Q: Passwords should be stored as\nA: ", "choices": ["plaintext in a protected table", "a fast MD5 hash", "reversible AES encryption", "a salted hash from a slow algorithm like bcrypt or Argon2"], "answer": 3}
{"id": "sec-authnz", "category": "security", "type": "multiple_choice", "prompt": "Q: Authentication answers 'who are you?'; authorisation answers\nA: ", "choices": ["what are you allowed to do?", "how fast is the request?", "where is the server located?", "when did you log in?"], "answer": 0}
{"id": "sec-leak", "category": "security", "type": "multiple_choice", "prompt": "Q: After an API key is accidentally committed to a public repository, the correct response is to\nA: ", "choices": ["delete the commit and assume it is safe", "rotate (revoke and reissue) the key", "make the repository private", "add the key to .gitignore"], "answer": 1}
{"id": "sec-tls", "category": "security", "type": "multiple_choice", "prompt": "Q: TLS primarily provides\nA: ", "choices": ["faster page loads", "confidentiality and integrity of data in transit", "protection against SQL injection", "automatic input validation"], "answer": 1}
{"id": "sec-leastpriv", "category": "security", "type": "multiple_choice", "prompt": "Q: The principle of least privilege means\nA: ", "choices": ["giving every user admin to avoid friction", "granting only the access needed to do the job", "disabling all logging", "using the shortest possible passwords"], "answer": 1}
